  "narrative": {
    "northStar": "Inherited Pitch OS workspace",
    "overview": "This is a scan of the finished Founder OS interface, preserving the established Pitch OS teal, light surfaces, sans typography and sidebar. The name describes the incumbent system; it does not introduce a new identity or an approved creative metaphor.\n\nThe interface uses flat work panels, compact data rows and readable labels. Brand expression comes from the teal actions and the A Story mark. Recommendation, uncertainty and evidence are presented as working information alongside the controls that act on them.",
    "keyCharacteristics": [
      "Teal actions on a light neutral workspace.",
      "Flat, bordered white work panels.",
      "A compact sans hierarchy with aligned numerals.",
      "Status words and explicit uncertainty alongside values.",
      "Sidebar navigation that becomes a horizontal mobile strip."
    ],
    "rules": [
      {
        "name": "The Status Words Rule",
        "body": "Color supports readable status text; eligibility remains labeled Meets, Fails or Unknown.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Reuse the existing tonal surfaces and fine borders when extending this workspace.",
        "section": "elevation"
      },
      {
        "name": "The Visible Uncertainty Rule",
        "body": "Keep unknown fit, eligibility, readiness, effort and usable value explicit in the relevant working component.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve the inherited teal, ink, light field, white panels and cool sidebar.",
      "**Do** keep supporting status text beside semantic colors.",
      "**Do** preserve unknown values, score ranges and the explanation of unresolved points.",
      "**Do** show readable evidence dates while retaining exact timestamps.",
      "**Do** keep owner proposal wording and the internal draft boundary visible beside the action.",
      "**Do** retain visible keyboard focus, labeled fields and live action feedback."
    ],
    "donts": [
      "**Don't** promote advertised benefits into confirmed usable value.",
      "**Don't** hide uncertainty when replacing a table with mobile records.",
      "**Don't** treat a design review as evidence that research or scheduling runs correctly.",
      "**Don't** introduce a new brand identity or decorative display face into this ordinary extension."
    ]
  }
}
